{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "schemaVersion": 1,
  "id": "spigot-modern",
  "revision": 1,
  "status": "reviewed",
  "category": "plugin",
  "platforms": ["spigot"],
  "profileRefs": ["spigot-modern"],
  "capabilities": [
    "commands",
    "permissions",
    "dependencies",
    "advanced-overrides"
  ],
  "fields": [
    {
      "id": "project-name",
      "type": "string",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "Tuple Probe"
    },
    {
      "id": "project-id",
      "type": "string",
      "label": "Project id",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "tuple-probe"
    },
    {
      "id": "project-version",
      "type": "version",
      "label": "Project version",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "1.0.0"
    },
    {
      "id": "main-class",
      "type": "string",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "TupleProbe"
    }
  ],
  "files": [
    {
      "source": "templates/shared/settings.gradle.tmpl",
      "destination": "settings.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/spigot/build.gradle.tmpl",
      "destination": "build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/gradle.properties.tmpl",
      "destination": "gradle.properties",
      "renderer": "properties",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/spigot/entrypoint.java.tmpl",
      "destination": "src/main/java/${project.packagePath}/${project.mainClass}.java",
      "renderer": "text",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/spigot/plugin.yml.tmpl",
      "destination": "src/main/resources/plugin.yml",
      "renderer": "yaml",
      "rawOverride": "advanced-only"
    }
  ],
  "assetSlots": [
    {
      "id": "icon",
      "mediaTypes": ["image/png"],
      "maxBytes": 1048576,
      "maxWidth": 512,
      "maxHeight": 512,
      "destinations": ["src/main/resources/icon.png"]
    }
  ],
  "renderTargets": [
    {
      "id": "advanced-field-extension",
      "path": "src/main/resources/META-INF/mcgen-advanced-fields.json",
      "format": "json",
      "fieldMappings": [
        { "fieldId": "*", "path": "extensions", "format": "json" }
      ],
      "required": false
    }
  ],
  "rawOperations": {
    "allowed": ["add", "replace", "rename", "delete", "reset", "diff"],
    "canonicalCi": "never-execute",
    "pathPolicy": "relative-safe"
  },
  "customization": {
    "$schema": "urn:mcgen:schema:customization-contract:1",
    "schemaVersion": 1,
    "fieldCatalogPaths": [
      "templates/shared/field-catalog.json",
      "templates/spigot/field-catalog.json"
    ],
    "simple": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "java-runtime",
        "build-dsl",
        "icon",
        "api-version"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "visible"
    },
    "advanced": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "group-id",
        "artifact-id",
        "archive-name",
        "classifier",
        "appendix",
        "extension",
        "java-runtime",
        "java-language",
        "build-dsl",
        "wrapper-version",
        "gradle-properties",
        "jvm-arguments",
        "dependencies",
        "repositories",
        "source-sets",
        "tasks",
        "runs",
        "publishing",
        "icon",
        "metadata-extensions",
        "raw-file-operations",
        "api-version",
        "load",
        "commands",
        "permissions",
        "depend",
        "soft-depend",
        "load-before",
        "libraries",
        "custom-fields"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "all"
    },
    "modeSwitch": {
      "preservesValues": true,
      "preservesDormantValues": true,
      "resolver": "shared"
    },
    "rawFiles": {
      "allowedOperations": [
        "add",
        "replace",
        "rename",
        "delete",
        "reset",
        "diff"
      ],
      "canonicalCiPolicy": "never-execute",
      "pathPolicy": "relative-safe"
    }
  }
}
