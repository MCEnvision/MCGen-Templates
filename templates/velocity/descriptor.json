{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "schemaVersion": 1,
  "id": "velocity",
  "revision": 1,
  "status": "blocked",
  "blockers": [
    {
      "code": "proxy-build-evidence",
      "reason": "Velocity API and protocol compatibility boundaries require later compilation and artifact inspection evidence.",
      "evidence": ["catalog/2026-08-10-r4/index.json"]
    }
  ],
  "category": "proxy",
  "platforms": ["velocity"],
  "profileRefs": ["velocity"],
  "capabilities": ["proxy-entrypoint", "commands", "advanced-overrides"],
  "fieldGroups": [
    {
      "id": "identity",
      "label": "Plugin identity",
      "order": 0,
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ]
    }
  ],
  "fields": [
    {
      "id": "project-name",
      "type": "string",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "Example Proxy"
    },
    {
      "id": "project-id",
      "type": "string",
      "label": "Plugin id",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "example-proxy"
    },
    {
      "id": "project-version",
      "type": "version",
      "label": "Plugin version",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "1.0.0"
    },
    {
      "id": "main-class",
      "type": "string",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "ExampleProxy"
    }
  ],
  "conditions": [],
  "files": [
    {
      "source": "templates/shared/README.md.tmpl",
      "destination": "README.md",
      "renderer": "text",
      "includeWhen": "true",
      "rawOverride": "advanced-only"
    }
  ],
  "renderTargets": [
    {
      "id": "velocity-metadata",
      "path": "src/main/resources/velocity-plugin.json",
      "format": "json",
      "fieldMappings": [
        { "fieldId": "project-id", "path": "id", "format": "literal" },
        { "fieldId": "main-class", "path": "main", "format": "literal" },
        { "fieldId": "project-version", "path": "version", "format": "version" }
      ],
      "required": true
    }
  ],
  "assetSlots": [
    {
      "id": "icon",
      "mediaTypes": ["image/png"],
      "maxBytes": 1048576,
      "maxWidth": 512,
      "maxHeight": 512,
      "destinations": ["src/main/resources/icon.png"]
    }
  ],
  "rawOperations": {
    "allowed": ["add", "replace", "rename", "delete", "reset", "diff"],
    "canonicalCi": "never-execute",
    "pathPolicy": "relative-safe"
  }
}
