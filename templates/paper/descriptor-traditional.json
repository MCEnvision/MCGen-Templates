{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "schemaVersion": 1,
  "id": "paper-traditional",
  "revision": 2,
  "status": "reviewed",
  "category": "plugin",
  "platforms": ["paper"],
  "profileRefs": ["paper-traditional"],
  "capabilities": [
    "commands",
    "permissions",
    "libraries",
    "paper-dependencies",
    "advanced-overrides"
  ],
  "fieldGroups": [
    {
      "id": "identity",
      "label": "Plugin identity",
      "order": 0,
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ]
    }
  ],
  "fields": [
    {
      "id": "project-name",
      "type": "string",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "Example Plugin"
    },
    {
      "id": "project-id",
      "type": "string",
      "label": "Plugin id",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "example-plugin"
    },
    {
      "id": "project-version",
      "type": "version",
      "label": "Plugin version",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "1.0.0"
    },
    {
      "id": "main-class",
      "type": "string",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "ExamplePlugin"
    }
  ],
  "conditions": [],
  "files": [
    {
      "source": "templates/shared/README.md.tmpl",
      "destination": "README.md",
      "renderer": "text",
      "includeWhen": "true",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/LICENSE.tmpl",
      "destination": "LICENSE",
      "renderer": "text",
      "rawOverride": "allowed"
    },
    {
      "source": "templates/paper/build.gradle.tmpl",
      "destination": "build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/settings.gradle.tmpl",
      "destination": "settings.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/gradle.properties.tmpl",
      "destination": "gradle.properties",
      "renderer": "properties",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/entrypoint.java.tmpl",
      "destination": "src/main/java/${project.packagePath}/${project.mainClass}.java",
      "renderer": "text",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/paper/plugin.yml.tmpl",
      "destination": "src/main/resources/plugin.yml",
      "renderer": "yaml",
      "rawOverride": "advanced-only"
    }
  ],
  "renderTargets": [
    {
      "id": "advanced-field-extension",
      "path": "src/main/resources/META-INF/mcgen-advanced-fields.json",
      "format": "json",
      "fieldMappings": [
        { "fieldId": "*", "path": "extensions", "format": "json" }
      ],
      "required": false
    }
  ],
  "assetSlots": [
    {
      "id": "icon",
      "mediaTypes": ["image/png"],
      "maxBytes": 1048576,
      "maxWidth": 512,
      "maxHeight": 512,
      "destinations": ["src/main/resources/icon.png"]
    }
  ],
  "rawOperations": {
    "allowed": ["add", "replace", "rename", "delete", "reset", "diff"],
    "canonicalCi": "never-execute",
    "pathPolicy": "relative-safe"
  },
  "customization": {
    "$schema": "urn:mcgen:schema:customization-contract:1",
    "schemaVersion": 1,
    "fieldCatalogPaths": [
      "templates/shared/field-catalog.json",
      "templates/paper/field-catalog.json"
    ],
    "simple": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "java-runtime",
        "build-dsl",
        "icon",
        "api-version"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "visible"
    },
    "advanced": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "group-id",
        "artifact-id",
        "archive-name",
        "classifier",
        "appendix",
        "extension",
        "java-runtime",
        "java-language",
        "build-dsl",
        "wrapper-version",
        "gradle-properties",
        "jvm-arguments",
        "dependencies",
        "repositories",
        "source-sets",
        "tasks",
        "runs",
        "publishing",
        "icon",
        "metadata-extensions",
        "raw-file-operations",
        "api-version",
        "load",
        "commands",
        "permissions",
        "depend",
        "soft-depend",
        "load-before",
        "libraries",
        "bootstrapper",
        "loader",
        "paper-dependencies",
        "paper-provides",
        "paper-plugin-json",
        "custom-fields"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "all"
    },
    "modeSwitch": {
      "preservesValues": true,
      "preservesDormantValues": true,
      "resolver": "shared"
    },
    "rawFiles": {
      "allowedOperations": [
        "add",
        "replace",
        "rename",
        "delete",
        "reset",
        "diff"
      ],
      "canonicalCiPolicy": "never-execute",
      "pathPolicy": "relative-safe"
    }
  }
}
