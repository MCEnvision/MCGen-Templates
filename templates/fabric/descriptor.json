{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "schemaVersion": 1,
  "id": "fabric",
  "revision": 1,
  "status": "blocked",
  "blockers": [
    {
      "code": "tuple-build-evidence",
      "reason": "Fabric Loom and mapping intersections remain discovered until later compilation and artifact inspection gates pass.",
      "evidence": ["catalog/2026-08-10-r4/index.json"]
    }
  ],
  "category": "mod",
  "platforms": ["fabric"],
  "profileRefs": ["fabric"],
  "capabilities": [
    "metadata",
    "mixins",
    "access-wideners",
    "data-generation",
    "advanced-overrides"
  ],
  "fieldGroups": [
    {
      "id": "identity",
      "label": "Project identity",
      "order": 0,
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ]
    }
  ],
  "fields": [
    {
      "id": "project-name",
      "type": "string",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "Example Mod"
    },
    {
      "id": "project-id",
      "type": "string",
      "label": "Project id",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "example-mod"
    },
    {
      "id": "project-version",
      "type": "version",
      "label": "Project version",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "1.0.0"
    },
    {
      "id": "main-class",
      "type": "string",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "ExampleMod"
    }
  ],
  "conditions": [],
  "files": [
    {
      "source": "templates/shared/README.md.tmpl",
      "destination": "README.md",
      "renderer": "text",
      "includeWhen": "true",
      "rawOverride": "advanced-only"
    }
  ],
  "renderTargets": [
    {
      "id": "fabric-metadata",
      "path": "src/main/resources/fabric.mod.json",
      "format": "json",
      "fieldMappings": [
        { "fieldId": "project-id", "path": "id", "format": "literal" },
        { "fieldId": "project-version", "path": "version", "format": "version" }
      ],
      "required": true
    }
  ],
  "assetSlots": [
    {
      "id": "icon",
      "mediaTypes": ["image/png"],
      "maxBytes": 1048576,
      "maxWidth": 512,
      "maxHeight": 512,
      "destinations": ["src/main/resources/assets/icon.png"]
    }
  ],
  "rawOperations": {
    "allowed": ["add", "replace", "rename", "delete", "reset", "diff"],
    "canonicalCi": "never-execute",
    "pathPolicy": "relative-safe"
  }
}
