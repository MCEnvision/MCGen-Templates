{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "schemaVersion": 1,
  "id": "fabric",
  "revision": 3,
  "status": "reviewed",
  "category": "mod",
  "platforms": ["fabric"],
  "profileRefs": ["fabric"],
  "capabilities": [
    "metadata",
    "mixins",
    "access-wideners",
    "data-generation",
    "advanced-overrides"
  ],
  "fieldGroups": [
    {
      "id": "identity",
      "label": "Project identity",
      "order": 0,
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ]
    }
  ],
  "fields": [
    {
      "id": "project-name",
      "type": "string",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "Example Mod"
    },
    {
      "id": "project-id",
      "type": "string",
      "label": "Project id",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "example-mod"
    },
    {
      "id": "project-version",
      "type": "version",
      "label": "Project version",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "1.0.0"
    },
    {
      "id": "main-class",
      "type": "string",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "ExampleMod"
    }
  ],
  "conditions": [],
  "files": [
    {
      "source": "templates/shared/README.md.tmpl",
      "destination": "README.md",
      "renderer": "text",
      "includeWhen": "true",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/LICENSE.tmpl",
      "destination": "LICENSE",
      "renderer": "text",
      "rawOverride": "allowed"
    },
    {
      "source": "templates/fabric/build.gradle.tmpl",
      "destination": "build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/fabric/settings.gradle.tmpl",
      "destination": "settings.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/gradle.properties.tmpl",
      "destination": "gradle.properties",
      "renderer": "properties",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/entrypoint.java.tmpl",
      "destination": "src/main/java/${project.packagePath}/${project.mainClass}.java",
      "renderer": "text",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/fabric/fabric.mod.json.tmpl",
      "destination": "src/main/resources/fabric.mod.json",
      "renderer": "json",
      "rawOverride": "advanced-only"
    }
  ],
  "renderTargets": [
    {
      "id": "fabric-metadata",
      "path": "src/main/resources/fabric.mod.json",
      "format": "json",
      "fieldMappings": [
        {
          "fieldId": "schema-version",
          "path": "schemaVersion",
          "format": "literal"
        },
        { "fieldId": "project-id", "path": "id", "format": "literal" },
        {
          "fieldId": "project-version",
          "path": "version",
          "format": "version"
        },
        { "fieldId": "project-name", "path": "name", "format": "text" },
        { "fieldId": "description", "path": "description", "format": "text" },
        { "fieldId": "authors", "path": "authors", "format": "json" },
        { "fieldId": "license", "path": "license", "format": "text" },
        { "fieldId": "environment", "path": "environment", "format": "text" },
        {
          "fieldId": "entrypoint",
          "path": "entrypoints.main[0]",
          "format": "text"
        }
      ],
      "required": true
    },
    {
      "id": "advanced-field-extension",
      "path": "src/main/resources/META-INF/mcgen-advanced-fields.json",
      "format": "json",
      "fieldMappings": [
        { "fieldId": "*", "path": "extensions", "format": "json" }
      ],
      "required": false
    }
  ],
  "assetSlots": [
    {
      "id": "icon",
      "mediaTypes": ["image/png"],
      "maxBytes": 1048576,
      "maxWidth": 512,
      "maxHeight": 512,
      "destinations": ["src/main/resources/assets/icon.png"]
    }
  ],
  "rawOperations": {
    "allowed": ["add", "replace", "rename", "delete", "reset", "diff"],
    "canonicalCi": "never-execute",
    "pathPolicy": "relative-safe"
  },
  "customization": {
    "$schema": "urn:mcgen:schema:customization-contract:1",
    "schemaVersion": 1,
    "fieldCatalogPaths": [
      "templates/shared/field-catalog.json",
      "templates/fabric/field-catalog.json"
    ],
    "simple": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "java-runtime",
        "build-dsl",
        "icon",
        "environment"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "visible"
    },
    "advanced": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "group-id",
        "artifact-id",
        "archive-name",
        "classifier",
        "appendix",
        "extension",
        "java-runtime",
        "java-language",
        "build-dsl",
        "wrapper-version",
        "gradle-properties",
        "jvm-arguments",
        "dependencies",
        "repositories",
        "source-sets",
        "tasks",
        "runs",
        "publishing",
        "icon",
        "metadata-extensions",
        "raw-file-operations",
        "environment",
        "entrypoints",
        "contact",
        "mixins",
        "access-wideners",
        "nested-jars",
        "language-adapters",
        "provides",
        "depends",
        "recommends",
        "breaks",
        "conflicts",
        "custom-fields"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "all"
    },
    "modeSwitch": {
      "preservesValues": true,
      "preservesDormantValues": true,
      "resolver": "shared"
    },
    "rawFiles": {
      "allowedOperations": [
        "add",
        "replace",
        "rename",
        "delete",
        "reset",
        "diff"
      ],
      "canonicalCiPolicy": "never-execute",
      "pathPolicy": "relative-safe"
    }
  }
}
