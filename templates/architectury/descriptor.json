{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "schemaVersion": 1,
  "id": "architectury",
  "revision": 2,
  "status": "reviewed",
  "category": "multiloader",
  "platforms": ["architectury"],
  "profileRefs": ["architectury-multiloader"],
  "capabilities": ["common-module", "target-overrides", "advanced-overrides"],
  "fieldGroups": [
    {
      "id": "identity",
      "label": "Project identity",
      "order": 0,
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ]
    }
  ],
  "fields": [
    {
      "id": "project-name",
      "type": "string",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "Example Mod"
    },
    {
      "id": "project-id",
      "type": "string",
      "label": "Project id",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "example-mod"
    },
    {
      "id": "project-version",
      "type": "version",
      "label": "Project version",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "1.0.0"
    },
    {
      "id": "main-class",
      "type": "string",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "editable": true,
      "defaultPolicy": "literal",
      "default": "ExampleMod"
    }
  ],
  "conditions": [],
  "files": [
    {
      "source": "templates/shared/README.md.tmpl",
      "destination": "README.md",
      "renderer": "text",
      "includeWhen": "true",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/shared/LICENSE.tmpl",
      "destination": "LICENSE",
      "renderer": "text",
      "rawOverride": "allowed"
    },
    {
      "source": "templates/architectury/root-build.gradle.tmpl",
      "destination": "build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/settings.gradle.tmpl",
      "destination": "settings.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/gradle.properties.tmpl",
      "destination": "gradle.properties",
      "renderer": "properties",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/common-entrypoint.java.tmpl",
      "destination": "common/src/main/java/${project.packagePath}/${project.mainClass}.java",
      "renderer": "text",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/common-build.gradle.tmpl",
      "destination": "common/build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/fabric-build.gradle.tmpl",
      "destination": "fabric/build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/forge-build.gradle.tmpl",
      "destination": "forge/build.gradle",
      "renderer": "gradle",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/forge-gradle.properties.tmpl",
      "destination": "forge/gradle.properties",
      "renderer": "properties",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/fabric-entrypoint.java.tmpl",
      "destination": "fabric/src/main/java/${project.packagePath}/${project.mainClass}Fabric.java",
      "renderer": "text",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/forge-entrypoint.java.tmpl",
      "destination": "forge/src/main/java/${project.packagePath}/${project.mainClass}Forge.java",
      "renderer": "text",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/fabric.mod.json.tmpl",
      "destination": "fabric/src/main/resources/fabric.mod.json",
      "renderer": "json",
      "rawOverride": "advanced-only"
    },
    {
      "source": "templates/architectury/forge.mods.toml.tmpl",
      "destination": "forge/src/main/resources/META-INF/mods.toml",
      "renderer": "toml",
      "rawOverride": "advanced-only"
    }
  ],
  "renderTargets": [
    {
      "id": "advanced-field-extension",
      "path": "src/main/resources/META-INF/mcgen-advanced-fields.json",
      "format": "json",
      "fieldMappings": [
        { "fieldId": "*", "path": "extensions", "format": "json" }
      ],
      "required": false
    }
  ],
  "assetSlots": [
    {
      "id": "icon",
      "mediaTypes": ["image/png"],
      "maxBytes": 1048576,
      "maxWidth": 512,
      "maxHeight": 512,
      "destinations": [
        "common/src/main/resources/icon.png",
        "fabric/src/main/resources/assets/${project.id}/icon.png",
        "forge/src/main/resources/assets/${project.id}/icon.png"
      ]
    }
  ],
  "rawOperations": {
    "allowed": ["add", "replace", "rename", "delete", "reset", "diff"],
    "canonicalCi": "never-execute",
    "pathPolicy": "relative-safe"
  },
  "customization": {
    "$schema": "urn:mcgen:schema:customization-contract:1",
    "schemaVersion": 1,
    "fieldCatalogPaths": [
      "templates/shared/field-catalog.json",
      "templates/architectury/field-catalog.json",
      "templates/fabric/field-catalog.json",
      "templates/forge/field-catalog.json",
      "templates/neoforge/field-catalog.json"
    ],
    "simple": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "java-runtime",
        "build-dsl",
        "icon",
        "loader-version",
        "environment",
        "targets",
        "common-metadata"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "visible"
    },
    "advanced": {
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "group-id",
        "artifact-id",
        "archive-name",
        "classifier",
        "appendix",
        "extension",
        "java-runtime",
        "java-language",
        "build-dsl",
        "wrapper-version",
        "gradle-properties",
        "jvm-arguments",
        "dependencies",
        "repositories",
        "source-sets",
        "tasks",
        "runs",
        "publishing",
        "icon",
        "metadata-extensions",
        "raw-file-operations",
        "loader-version",
        "services",
        "links",
        "mods",
        "display",
        "logo",
        "features",
        "display-test",
        "ordering",
        "logical-sides",
        "custom-fields",
        "environment",
        "entrypoints",
        "contact",
        "mixins",
        "access-wideners",
        "nested-jars",
        "language-adapters",
        "provides",
        "depends",
        "recommends",
        "breaks",
        "conflicts",
        "targets",
        "common-metadata",
        "target-overrides",
        "target-dependencies",
        "target-source-layout",
        "target-artifacts"
      ],
      "defaultPolicy": "descriptor-defaults",
      "warnings": true,
      "overrides": "all"
    },
    "modeSwitch": {
      "preservesValues": true,
      "preservesDormantValues": true,
      "resolver": "shared"
    },
    "rawFiles": {
      "allowedOperations": [
        "add",
        "replace",
        "rename",
        "delete",
        "reset",
        "diff"
      ],
      "canonicalCiPolicy": "never-execute",
      "pathPolicy": "relative-safe"
    }
  }
}
