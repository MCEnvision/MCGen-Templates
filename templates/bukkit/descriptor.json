{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "assetSlots": [
    {
      "destinations": ["src/main/resources/icon.png"],
      "id": "icon",
      "maxBytes": 1048576,
      "maxHeight": 512,
      "maxWidth": 512,
      "mediaTypes": ["image/png"]
    }
  ],
  "buildSystems": ["gradle"],
  "capabilities": [
    "commands",
    "permissions",
    "dependencies",
    "advanced-overrides"
  ],
  "category": "plugin",
  "conditions": [],
  "customization": {
    "$schema": "urn:mcgen:schema:customization-contract:1",
    "advanced": {
      "defaultPolicy": "descriptor-defaults",
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "group-id",
        "artifact-id",
        "archive-name",
        "classifier",
        "appendix",
        "extension",
        "java-runtime",
        "java-language",
        "build-dsl",
        "wrapper-version",
        "gradle-properties",
        "jvm-arguments",
        "dependencies",
        "repositories",
        "source-sets",
        "tasks",
        "runs",
        "publishing",
        "icon",
        "metadata-extensions",
        "raw-file-operations",
        "api-version",
        "load",
        "commands",
        "permissions",
        "depend",
        "soft-depend",
        "load-before",
        "libraries",
        "bootstrapper",
        "loader",
        "custom-fields"
      ],
      "overrides": "all",
      "warnings": true
    },
    "fieldCatalogPaths": [
      "templates/shared/field-catalog.json",
      "templates/bukkit/field-catalog.json"
    ],
    "modeSwitch": {
      "preservesDormantValues": true,
      "preservesValues": true,
      "resolver": "shared"
    },
    "rawFiles": {
      "allowedOperations": [
        "add",
        "replace",
        "rename",
        "delete",
        "reset",
        "diff"
      ],
      "canonicalCiPolicy": "never-execute",
      "pathPolicy": "relative-safe"
    },
    "schemaVersion": 1,
    "simple": {
      "defaultPolicy": "descriptor-defaults",
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "java-runtime",
        "build-dsl",
        "icon",
        "api-version"
      ],
      "overrides": "visible",
      "warnings": true
    }
  },
  "fieldGroups": [
    {
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ],
      "id": "identity",
      "label": "Plugin identity",
      "order": 0
    }
  ],
  "fields": [
    {
      "default": "Example Plugin",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "project-name",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "string"
    },
    {
      "default": "example-plugin",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "project-id",
      "label": "Plugin id",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "string"
    },
    {
      "default": "1.0.0",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "project-version",
      "label": "Plugin version",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "version"
    },
    {
      "default": "ExamplePlugin",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "main-class",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "string"
    }
  ],
  "files": [
    {
      "destination": "README.md",
      "includeWhen": "true",
      "rawOverride": "advanced-only",
      "renderer": "text",
      "source": "templates/shared/README.md.tmpl"
    },
    {
      "destination": "LICENSE",
      "rawOverride": "allowed",
      "renderer": "text",
      "source": "templates/shared/LICENSE.tmpl"
    },
    {
      "destination": "build.gradle",
      "includeWhen": "sourceLanguage.java && gradleDsl.groovy",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/bukkit/build.gradle.tmpl"
    },
    {
      "destination": "build.gradle",
      "includeWhen": "sourceLanguage.kotlin && gradleDsl.groovy",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/bukkit/build-kotlin.gradle.tmpl"
    },
    {
      "destination": "build.gradle.kts",
      "includeWhen": "sourceLanguage.java && gradleDsl.kotlin",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/bukkit/build-java.gradle.kts.tmpl"
    },
    {
      "destination": "build.gradle.kts",
      "includeWhen": "sourceLanguage.kotlin && gradleDsl.kotlin",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/bukkit/build.gradle.kts.tmpl"
    },
    {
      "destination": "settings.gradle",
      "includeWhen": "gradleDsl.groovy",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/shared/settings.gradle.tmpl"
    },
    {
      "destination": "settings.gradle.kts",
      "includeWhen": "gradleDsl.kotlin",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/shared/settings.gradle.kts.tmpl"
    },
    {
      "destination": "gradle.properties",
      "rawOverride": "advanced-only",
      "renderer": "properties",
      "source": "templates/shared/gradle.properties.tmpl"
    },
    {
      "destination": "src/main/java/${project.packagePath}/${project.mainClass}.java",
      "includeWhen": "sourceLanguage.java",
      "rawOverride": "advanced-only",
      "renderer": "text",
      "source": "templates/bukkit/entrypoint.java.tmpl"
    },
    {
      "destination": "src/main/kotlin/${project.packagePath}/${project.mainClass}.kt",
      "includeWhen": "sourceLanguage.kotlin",
      "rawOverride": "advanced-only",
      "renderer": "text",
      "source": "templates/bukkit/entrypoint.kt.tmpl"
    },
    {
      "destination": "src/main/resources/plugin.yml",
      "rawOverride": "advanced-only",
      "renderer": "yaml",
      "source": "templates/bukkit/plugin.yml.tmpl"
    }
  ],
  "gradleDsls": ["groovy", "kotlin"],
  "id": "bukkit",
  "platforms": ["bukkit"],
  "profileRefs": ["bukkit"],
  "rawOperationPolicy": {
    "allowedOperations": [
      "add",
      "replace",
      "rename",
      "delete",
      "reset",
      "diff"
    ],
    "allowedPathPrefixes": [
      "LICENSE",
      "README.md",
      "build.gradle",
      "build.gradle.kts",
      "gradle.properties",
      "settings.gradle",
      "settings.gradle.kts",
      "src/"
    ],
    "canonicalCi": "never-execute",
    "maxContentBytes": 1048576,
    "maxOperations": 128,
    "pathPolicy": "allowed-prefixes"
  },
  "renderTargets": [
    {
      "fieldMappings": [
        {
          "fieldId": "*",
          "format": "json",
          "path": "extensions"
        }
      ],
      "format": "json",
      "id": "advanced-field-extension",
      "path": "src/main/resources/META-INF/mcgen-advanced-fields.json",
      "required": false
    }
  ],
  "revision": 4,
  "schemaVersion": 1,
  "sourceLanguages": ["java", "kotlin"],
  "status": "reviewed"
}
