{
  "$schema": "urn:mcgen:schema:template-descriptor:1",
  "assetSlots": [
    {
      "destinations": ["src/main/resources/icon.png"],
      "id": "icon",
      "maxBytes": 1048576,
      "maxHeight": 512,
      "maxWidth": 512,
      "mediaTypes": ["image/png"]
    }
  ],
  "buildSystems": ["gradle"],
  "capabilities": [
    "metadata",
    "mixins",
    "data-generation",
    "advanced-overrides"
  ],
  "category": "mod",
  "conditions": [],
  "customization": {
    "$schema": "urn:mcgen:schema:customization-contract:1",
    "advanced": {
      "defaultPolicy": "descriptor-defaults",
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "group-id",
        "artifact-id",
        "archive-name",
        "classifier",
        "appendix",
        "extension",
        "java-runtime",
        "java-language",
        "build-dsl",
        "wrapper-version",
        "gradle-properties",
        "jvm-arguments",
        "dependencies",
        "repositories",
        "source-sets",
        "tasks",
        "runs",
        "publishing",
        "icon",
        "metadata-extensions",
        "raw-file-operations",
        "loader-version",
        "services",
        "links",
        "mods",
        "display",
        "logo",
        "features",
        "display-test",
        "ordering",
        "logical-sides",
        "custom-fields"
      ],
      "overrides": "all",
      "warnings": true
    },
    "fieldCatalogPaths": [
      "templates/shared/field-catalog.json",
      "templates/forge/field-catalog.json"
    ],
    "modeSwitch": {
      "preservesDormantValues": true,
      "preservesValues": true,
      "resolver": "shared"
    },
    "rawFiles": {
      "allowedOperations": [
        "add",
        "replace",
        "rename",
        "delete",
        "reset",
        "diff"
      ],
      "canonicalCiPolicy": "never-execute",
      "pathPolicy": "relative-safe"
    },
    "schemaVersion": 1,
    "simple": {
      "defaultPolicy": "descriptor-defaults",
      "fields": [
        "project-name",
        "project-id",
        "project-version",
        "main-class",
        "description",
        "authors",
        "website",
        "license",
        "package",
        "java-runtime",
        "build-dsl",
        "icon",
        "loader-version"
      ],
      "overrides": "visible",
      "warnings": true
    }
  },
  "fieldGroups": [
    {
      "fieldIds": [
        "project-name",
        "project-id",
        "project-version",
        "main-class"
      ],
      "id": "identity",
      "label": "Project identity",
      "order": 0
    }
  ],
  "fields": [
    {
      "default": "Example Mod",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "project-name",
      "label": "Project name",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "string"
    },
    {
      "default": "example-mod",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "project-id",
      "label": "Project id",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "string"
    },
    {
      "default": "1.0.0",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "project-version",
      "label": "Project version",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "version"
    },
    {
      "default": "ExampleMod",
      "defaultPolicy": "literal",
      "editable": true,
      "id": "main-class",
      "label": "Main class",
      "modes": ["simple", "advanced"],
      "required": true,
      "type": "string"
    }
  ],
  "files": [
    {
      "destination": "README.md",
      "includeWhen": "true",
      "rawOverride": "advanced-only",
      "renderer": "text",
      "source": "templates/shared/README.md.tmpl"
    },
    {
      "destination": "LICENSE",
      "rawOverride": "allowed",
      "renderer": "text",
      "source": "templates/shared/LICENSE.tmpl"
    },
    {
      "destination": "build.gradle",
      "includeWhen": "field(\"forgegradle\") != \"3.0.197\"",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/forge/build.gradle.tmpl"
    },
    {
      "destination": "build.gradle",
      "includeWhen": "field(\"forgegradle\") == \"3.0.197\"",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/forge/legacy-build.gradle.tmpl"
    },
    {
      "destination": "settings.gradle",
      "includeWhen": "field(\"forgegradle\") != \"3.0.197\"",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/forge/settings.gradle.tmpl"
    },
    {
      "destination": "settings.gradle",
      "includeWhen": "field(\"forgegradle\") == \"3.0.197\"",
      "rawOverride": "advanced-only",
      "renderer": "gradle",
      "source": "templates/forge/legacy-settings.gradle.tmpl"
    },
    {
      "destination": "gradle.properties",
      "rawOverride": "advanced-only",
      "renderer": "properties",
      "source": "templates/shared/gradle.properties.tmpl"
    },
    {
      "destination": "src/main/java/${project.packagePath}/${project.mainClass}.java",
      "rawOverride": "advanced-only",
      "renderer": "text",
      "source": "templates/shared/entrypoint.java.tmpl"
    },
    {
      "destination": "src/main/resources/META-INF/mods.toml",
      "includeWhen": "field(\"forgegradle\") != \"3.0.197\"",
      "rawOverride": "advanced-only",
      "renderer": "toml",
      "source": "templates/forge/mods.toml.tmpl"
    },
    {
      "destination": "src/main/resources/mcmod.info",
      "includeWhen": "field(\"forgegradle\") == \"3.0.197\"",
      "rawOverride": "advanced-only",
      "renderer": "json",
      "source": "templates/forge/mcmod.info.tmpl"
    }
  ],
  "gradleDsls": ["groovy"],
  "id": "forge",
  "platforms": ["forge"],
  "profileRefs": ["forge-legacy", "forge-modern"],
  "rawOperationPolicy": {
    "allowedOperations": [
      "add",
      "replace",
      "rename",
      "delete",
      "reset",
      "diff"
    ],
    "allowedPathPrefixes": [
      "LICENSE",
      "README.md",
      "build.gradle",
      "gradle.properties",
      "settings.gradle",
      "src/"
    ],
    "canonicalCi": "never-execute",
    "maxContentBytes": 1048576,
    "maxOperations": 128,
    "pathPolicy": "allowed-prefixes"
  },
  "renderTargets": [
    {
      "fieldMappings": [
        {
          "fieldId": "*",
          "format": "json",
          "path": "extensions"
        }
      ],
      "format": "json",
      "id": "advanced-field-extension",
      "path": "src/main/resources/META-INF/mcgen-advanced-fields.json",
      "required": false
    }
  ],
  "revision": 3,
  "schemaVersion": 1,
  "sourceLanguages": ["java"],
  "status": "reviewed"
}
