{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:customization-contract:1",
  "title": "MCGen Simple and Advanced customization contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "simple",
    "advanced",
    "modeSwitch",
    "rawFiles"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:customization-contract:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "simple": { "$ref": "#/$defs/mode" },
    "advanced": { "$ref": "#/$defs/mode" },
    "modeSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preservesValues", "preservesDormantValues", "resolver"],
      "properties": {
        "preservesValues": { "const": true },
        "preservesDormantValues": { "const": true },
        "resolver": { "enum": ["shared", "descriptor"] }
      }
    },
    "rawFiles": { "$ref": "#/$defs/rawFiles" },
    "extensions": { "$ref": "urn:mcgen:schema:common:1#/$defs/extensions" }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "defaultPolicy", "warnings", "overrides"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" }
        },
        "defaultPolicy": {
          "enum": ["catalog-recommended", "descriptor-defaults", "none"]
        },
        "warnings": { "type": "boolean" },
        "overrides": { "enum": ["hidden", "visible", "all"] }
      }
    },
    "rawFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOperations", "canonicalCiPolicy", "pathPolicy"],
      "properties": {
        "allowedOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["add", "replace", "rename", "delete", "reset", "diff"]
          }
        },
        "canonicalCiPolicy": { "enum": ["never-execute", "validate-only"] },
        "pathPolicy": { "enum": ["relative-safe", "descriptor-only"] }
      }
    }
  }
}
