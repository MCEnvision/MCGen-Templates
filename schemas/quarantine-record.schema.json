{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:quarantine-record:1",
  "title": "MCGen non destructive maintenance quarantine record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "quarantineId",
    "createdAt",
    "sourceFamily",
    "adapterId",
    "outcome",
    "baseline",
    "candidate",
    "affectedCoordinates",
    "affectedTuples",
    "preserveLastKnownGood",
    "publicationBlocked",
    "status",
    "recoverySteps",
    "reason"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:quarantine-record:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "kind": { "const": "quarantine-record" },
    "quarantineId": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceFamily": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
    },
    "adapterId": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
    },
    "outcome": {
      "enum": [
        "artifact-missing",
        "artifact-mutated",
        "repository-protocol-failure",
        "unsupported-host-jdk",
        "profile-mismatch",
        "template-defect",
        "upstream-defect",
        "empty-response",
        "malformed-response",
        "bulk-removal"
      ]
    },
    "baseline": { "$ref": "#/$defs/snapshot" },
    "candidate": {
      "anyOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "null" }]
    },
    "affectedCoordinates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "affectedTuples": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "preserveLastKnownGood": { "const": true },
    "publicationBlocked": { "const": true },
    "status": { "enum": ["open", "resolved"] },
    "recoverySteps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
        "digest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/-]+\\.json$"
        }
      }
    }
  }
}
