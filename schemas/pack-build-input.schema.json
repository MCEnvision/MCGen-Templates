{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:pack-build-input:1",
  "title": "MCGen deterministic pack build input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "packVersion",
    "sourceCommit",
    "createdAt",
    "files"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:pack-build-input:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "catalogSnapshot": { "type": "string", "minLength": 1, "maxLength": 128 },
    "familyRevisions": {
      "$ref": "urn:mcgen:schema:pack-manifest:1#/$defs/revisions"
    },
    "profileRevisions": {
      "$ref": "urn:mcgen:schema:pack-manifest:1#/$defs/revisions"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "$ref": "urn:mcgen:schema:common:1#/$defs/relativePath" }
        }
      }
    }
  }
}
