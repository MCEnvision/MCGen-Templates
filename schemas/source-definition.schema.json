{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:source-definition:1",
  "title": "MCGen authoritative source definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "platform",
    "category",
    "adapter",
    "sources",
    "removalPolicy",
    "requestPolicy"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:source-definition:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "platform": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "category": {
      "enum": ["mod", "plugin", "proxy", "multiloader", "toolchain"]
    },
    "adapter": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "url", "expectedContentTypes"],
        "properties": {
          "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "role": { "enum": ["primary", "prerequisite", "corroborating"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "expectedContentTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }
          }
        }
      }
    },
    "removalPolicy": { "const": "additive-only" },
    "requestPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 }
      }
    }
  }
}
