{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:toolchain-profile:1",
  "title": "MCGen toolchain profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "revision",
    "platform",
    "catalogRange",
    "java",
    "buildSystem",
    "plugins",
    "repositories",
    "verification"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:toolchain-profile:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "platform": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "catalogRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression"],
      "properties": {
        "kind": { "enum": ["minecraft", "api"] },
        "expression": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "java": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "language", "bytecode"],
      "properties": {
        "runtime": { "type": "integer", "minimum": 6, "maximum": 99 },
        "language": { "type": "integer", "minimum": 6, "maximum": 99 },
        "bytecode": { "type": "integer", "minimum": 6, "maximum": 99 }
      }
    },
    "buildSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "distributionSha256"],
      "properties": {
        "kind": { "enum": ["gradle", "maven"] },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![Ll][Aa][Tt][Ee][Ss][Tt]$).+$"
        },
        "distributionSha256": {
          "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?![Ll][Aa][Tt][Ee][Ss][Tt]$).+$"
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "artifactPatterns"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "artifactPatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
