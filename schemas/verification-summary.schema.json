{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:verification-summary:1",
  "title": "MCGen template pack verification summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "packVersion",
    "sourceCommit",
    "status",
    "checks"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:verification-summary:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "status": { "enum": ["candidate", "verified", "blocked"] },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sha512", "bytes"],
      "properties": {
        "path": { "$ref": "urn:mcgen:schema:common:1#/$defs/relativePath" },
        "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "status": { "enum": ["passed", "blocked", "failed", "not-run"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "coverage": { "$ref": "urn:mcgen:schema:common:1#/$defs/relativePath" },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    }
  }
}
