{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:source-snapshot:1",
  "title": "MCGen normalized source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "snapshotId",
    "adapter",
    "createdAt",
    "sources",
    "entries",
    "rejected",
    "warnings"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:source-snapshot:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "provenanceVersion": { "const": 1 },
    "snapshotId": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "retrievedAt", "contentType", "sha256", "bytes"],
        "properties": {
          "sourceId": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "role": { "enum": ["primary", "prerequisite", "corroborating"] },
          "requestedUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "redirectChain": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "contentType": { "type": "string", "minLength": 1 },
          "etag": { "type": "string", "minLength": 1 },
          "lastModified": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "component",
          "catalogKey",
          "version",
          "coordinate",
          "channel",
          "sourceIndexes"
        ],
        "properties": {
          "platform": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "component": {
            "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
          },
          "catalogKey": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 },
          "coordinate": { "type": "string", "minLength": 1, "maxLength": 512 },
          "channel": {
            "$ref": "urn:mcgen:schema:common:1#/$defs/stabilityChannel"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "sourceIndexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "reason", "sourceIndex"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "sourceIndex": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provenanceVersion": { "const": 1 } },
        "required": ["provenanceVersion"]
      },
      "then": {
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": true,
                "role": true,
                "requestedUrl": true,
                "url": true,
                "redirectChain": true,
                "retrievedAt": true,
                "contentType": true,
                "sha256": true,
                "bytes": true
              },
              "required": [
                "sourceId",
                "role",
                "requestedUrl",
                "url",
                "redirectChain",
                "retrievedAt",
                "contentType",
                "sha256",
                "bytes"
              ]
            }
          }
        }
      }
    }
  ]
}
