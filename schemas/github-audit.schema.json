{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:github-audit:1",
  "title": "MCGen read only GitHub repository capability audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "auditId",
    "generatedAt",
    "repository",
    "readOnly",
    "mutationsAttempted",
    "status",
    "capabilities",
    "blockers"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:github-audit:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "kind": { "const": "github-audit" },
    "auditId": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repository": { "$ref": "#/$defs/repository" },
    "readOnly": { "const": true },
    "mutationsAttempted": { "const": 0 },
    "status": { "enum": ["passed", "blocked"] },
    "capabilities": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/capability" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "defaultBranch", "visibility"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "defaultBranch": {
          "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
        },
        "visibility": { "enum": ["public", "private", "internal"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "detail", "evidence"],
      "properties": {
        "id": {
          "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
        },
        "state": {
          "enum": ["passed", "blocked", "unavailable", "failed"]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "detail"],
      "properties": {
        "kind": {
          "enum": ["github-api", "repository-file", "repository-directory"]
        },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "digest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}
