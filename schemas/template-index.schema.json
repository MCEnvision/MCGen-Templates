{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:template-index:1",
  "title": "MCGen template descriptor index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profilesIndex", "descriptors"],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:template-index:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "profilesIndex": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/relativePath"
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "path": { "$ref": "urn:mcgen:schema:common:1#/$defs/relativePath" },
          "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
        }
      }
    }
  }
}
