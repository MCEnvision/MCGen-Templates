{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:spdx-sbom:1",
  "title": "MCGen SPDX 2.3 software bill of materials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SPDXID",
    "$schema",
    "spdxVersion",
    "dataLicense",
    "name",
    "documentNamespace",
    "creationInfo",
    "packages",
    "files",
    "relationships"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:spdx-sbom:1" },
    "SPDXID": { "const": "SPDXRef-DOCUMENT" },
    "spdxVersion": { "const": "SPDX-2.3" },
    "dataLicense": { "const": "CC0-1.0" },
    "name": { "type": "string", "minLength": 1 },
    "documentNamespace": { "type": "string", "format": "uri" },
    "creationInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "creators", "licenseListVersion"],
      "properties": {
        "created": { "type": "string", "format": "date-time" },
        "creators": {
          "const": ["Tool: mcgen-template-pack"]
        },
        "licenseListVersion": { "const": "3.23" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "SPDXID",
          "name",
          "versionInfo",
          "downloadLocation",
          "licenseConcluded",
          "licenseDeclared",
          "filesAnalyzed"
        ],
        "properties": {
          "SPDXID": { "const": "SPDXRef-Package-MCGenTemplatePack" },
          "name": { "const": "mcgen-template-pack" },
          "versionInfo": { "type": "string", "minLength": 1 },
          "downloadLocation": { "const": "NOASSERTION" },
          "licenseConcluded": { "const": "NOASSERTION" },
          "licenseDeclared": { "const": "NOASSERTION" },
          "filesAnalyzed": { "const": true }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["SPDXID", "fileName", "checksums", "licenseConcluded"],
        "properties": {
          "SPDXID": {
            "type": "string",
            "pattern": "^SPDXRef-File-[a-f0-9]{16}$"
          },
          "fileName": { "type": "string", "minLength": 1 },
          "checksums": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "checksum"],
              "properties": {
                "algorithm": { "const": "SHA256" },
                "checksum": {
                  "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
                }
              }
            }
          },
          "licenseConcluded": { "const": "NOASSERTION" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spdxElementId", "relationshipType", "relatedSpdxElement"],
        "properties": {
          "spdxElementId": { "type": "string", "minLength": 1 },
          "relationshipType": { "enum": ["DESCRIBES", "CONTAINS"] },
          "relatedSpdxElement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
