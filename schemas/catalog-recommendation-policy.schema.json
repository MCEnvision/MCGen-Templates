{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:catalog-recommendation-policy:1",
  "title": "MCGen deterministic recommendation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "version",
    "eligibleStatuses",
    "eligibleChannels",
    "tieBreakOrder",
    "fallback"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:catalog-recommendation-policy:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "eligibleStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["verified", "legacy-verified"] }
    },
    "eligibleChannels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "release" }
    },
    "tieBreakOrder": {
      "type": "array",
      "const": [
        "official-marker",
        "status",
        "nondeprecated",
        "version",
        "evidence",
        "text"
      ]
    },
    "fallback": { "const": "none" }
  }
}
