{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:catalog:1",
  "title": "MCGen compatibility catalog shard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "snapshotId",
    "platform",
    "keyKind",
    "targets"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:catalog:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "snapshotId": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "platform": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "keyKind": { "enum": ["minecraft", "api"] },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "family",
          "profile",
          "components",
          "status",
          "evidence"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 128 },
          "family": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "profile": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "components": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "recommended": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "status": {
            "$ref": "urn:mcgen:schema:common:1#/$defs/verificationStatus"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      }
    }
  }
}
