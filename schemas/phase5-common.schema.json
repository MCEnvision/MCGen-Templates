{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:phase5-common:1",
  "title": "MCGen phase 5 shared contracts",
  "$defs": {
    "tupleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "descriptorId",
        "descriptorRevision",
        "profileId",
        "profileRevision",
        "catalogSnapshotId",
        "catalogKey",
        "components",
        "fixtureId",
        "sourceLanguage",
        "buildSystem",
        "contentDigests",
        "java",
        "wrapper",
        "mappingDigest",
        "sourceDigests",
        "procedureDigest"
      ],
      "properties": {
        "family": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
        "descriptorId": {
          "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
        },
        "descriptorRevision": { "type": "integer", "minimum": 1 },
        "profileId": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
        "profileRevision": { "type": "integer", "minimum": 1 },
        "catalogSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "catalogKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "fixtureId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceLanguage": { "enum": ["java", "kotlin"] },
        "buildSystem": { "enum": ["gradle", "maven"] },
        "gradleDsl": { "enum": ["groovy", "kotlin"] },
        "contentDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descriptor",
            "profile",
            "catalog",
            "fixture",
            "template"
          ],
          "properties": {
            "descriptor": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
            "profile": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
            "catalog": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
            "fixture": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
            "template": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
          }
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "runtime"],
          "properties": {
            "distribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "runtime": { "type": "integer", "minimum": 6, "maximum": 99 },
            "checksum": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
          }
        },
        "wrapper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
            "kind": {
              "enum": ["launcher-script", "wrapper-jar", "distribution"]
            },
            "distributionUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://services\\.gradle\\.org/distributions/gradle-[^/]+-bin\\.zip$"
            },
            "distributionSha256": {
              "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
            }
          }
        },
        "mappingDigest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "sourceDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
        },
        "procedureDigest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "language", "version", "rawOverride"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "kind": {
          "enum": [
            "minimal-java",
            "minimal-kotlin",
            "maximum-structured",
            "alpha",
            "beta",
            "release-candidate",
            "snapshot",
            "build-metadata",
            "custom-png",
            "optional-features",
            "raw-override",
            "multiloader-targets"
          ]
        },
        "language": { "enum": ["java", "kotlin"] },
        "buildSystem": { "enum": ["gradle", "maven"] },
        "gradleDsl": { "enum": ["groovy", "kotlin"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rawOverride": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "purpose"],
      "properties": {
        "executable": { "type": "string", "minLength": 1, "maxLength": 256 },
        "args": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 }
        },
        "purpose": {
          "enum": [
            "format",
            "static-validation",
            "unit-tests",
            "data-generation",
            "gametests",
            "build",
            "package"
          ]
        }
      }
    },
    "buildContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java",
        "wrapper",
        "commands",
        "workDirectoryPolicy",
        "rawOverridePolicy",
        "limits"
      ],
      "properties": {
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "runtime"],
          "properties": {
            "distribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "runtime": { "type": "integer", "minimum": 6, "maximum": 99 },
            "checksum": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
          }
        },
        "wrapper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
            "kind": {
              "enum": ["launcher-script", "wrapper-jar", "distribution"]
            },
            "distributionUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://services\\.gradle\\.org/distributions/gradle-[^/]+-bin\\.zip$"
            },
            "distributionSha256": {
              "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
            }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        },
        "workDirectoryPolicy": { "const": "isolated-clean" },
        "rawOverridePolicy": { "enum": ["never-execute", "validate-only"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeoutMs",
            "maxOutputBytes",
            "maxDiskBytes",
            "retries",
            "artifactRetentionDays"
          ],
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 67108864
            },
            "maxDiskBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 4294967296
            },
            "retries": { "type": "integer", "minimum": 0, "maximum": 3 },
            "artifactRetentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        }
      }
    },
    "artifactExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "metadataPaths",
        "requiredEntries",
        "entrypointClasses",
        "resourceNamespaces",
        "iconPaths",
        "expectedExtension"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "metadataPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "requiredEntries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "entrypointClasses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "resourceNamespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "iconPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "expectedExtension": { "enum": [".jar", ".zip"] },
        "expectedClassifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publicationCoordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "artifact", "version"],
          "properties": {
            "group": { "type": "string", "minLength": 1, "maxLength": 512 },
            "artifact": { "type": "string", "minLength": 1, "maxLength": 512 },
            "version": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        "projectIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 512 },
            "name": { "type": "string", "minLength": 1, "maxLength": 512 },
            "version": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        "metadataFields": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "iconReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metadataPath", "iconPath"],
            "properties": {
              "metadataPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "iconPath": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "maxEntries": { "type": "integer", "minimum": 1 }
      }
    },
    "buildEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "startedAt", "finishedAt", "commands"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked", "skipped"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exitCode", "durationMs", "outputDigest"],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "exitCode": { "type": ["integer", "null"] },
              "durationMs": { "type": "integer", "minimum": 0 },
              "outputDigest": {
                "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
              },
              "outputBytes": {
                "type": "integer",
                "minimum": 0
              },
              "diskBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "failureClass": {
          "enum": ["deterministic", "transient", "policy", "environment"]
        }
      }
    },
    "artifactInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "sha256",
        "bytes",
        "entries",
        "metadata",
        "failures",
        "warnings"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "format", "valid", "values"],
            "properties": {
              "path": { "type": "string" },
              "format": {
                "enum": ["json", "properties", "toml", "text", "unknown"]
              },
              "valid": { "type": "boolean" },
              "values": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        },
        "failures": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
