{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:phase5-common:1",
  "title": "MCGen phase 5 shared contracts",
  "$defs": {
    "tupleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "descriptorId",
        "descriptorRevision",
        "profileId",
        "profileRevision",
        "catalogSnapshotId",
        "catalogKey",
        "components",
        "fixtureId",
        "java",
        "wrapper",
        "mappingDigest",
        "sourceDigests",
        "procedureDigest"
      ],
      "properties": {
        "family": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
        "descriptorId": {
          "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
        },
        "descriptorRevision": { "type": "integer", "minimum": 1 },
        "profileId": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
        "profileRevision": { "type": "integer", "minimum": 1 },
        "catalogSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "catalogKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "fixtureId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "runtime"],
          "properties": {
            "distribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "runtime": { "type": "integer", "minimum": 6, "maximum": 99 },
            "checksum": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
          }
        },
        "wrapper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
          }
        },
        "mappingDigest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "sourceDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
        },
        "procedureDigest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "language", "version", "rawOverride"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "kind": {
          "enum": [
            "minimal-java",
            "minimal-kotlin",
            "maximum-structured",
            "alpha",
            "beta",
            "release-candidate",
            "snapshot",
            "build-metadata",
            "custom-png",
            "optional-features",
            "raw-override",
            "multiloader-targets"
          ]
        },
        "language": { "enum": ["java", "kotlin"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rawOverride": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "purpose"],
      "properties": {
        "executable": { "type": "string", "minLength": 1, "maxLength": 256 },
        "args": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 }
        },
        "purpose": {
          "enum": [
            "format",
            "static-validation",
            "unit-tests",
            "data-generation",
            "gametests",
            "build",
            "package"
          ]
        }
      }
    },
    "buildEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "startedAt", "finishedAt", "commands"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked", "skipped"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exitCode", "durationMs", "outputDigest"],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "exitCode": { "type": ["integer", "null"] },
              "durationMs": { "type": "integer", "minimum": 0 },
              "outputDigest": {
                "$ref": "urn:mcgen:schema:common:1#/$defs/digest"
              },
              "outputBytes": {
                "type": "integer",
                "minimum": 0
              },
              "diskBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "failureClass": {
          "enum": ["deterministic", "transient", "policy", "environment"]
        }
      }
    },
    "artifactInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "sha256",
        "bytes",
        "entries",
        "metadata",
        "failures",
        "warnings"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "format", "valid", "values"],
            "properties": {
              "path": { "type": "string" },
              "format": { "enum": ["json", "properties", "text", "unknown"] },
              "valid": { "type": "boolean" },
              "values": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        },
        "failures": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
