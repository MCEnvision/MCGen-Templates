{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:template-descriptor:1",
  "title": "MCGen template descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "revision",
    "category",
    "platforms",
    "capabilities",
    "properties",
    "files",
    "assetSlots"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:template-descriptor:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "category": { "enum": ["mod", "plugin", "proxy", "multiloader"] },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "modes", "required"],
        "properties": {
          "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "type": {
            "enum": [
              "string",
              "boolean",
              "integer",
              "enum",
              "version",
              "coordinate",
              "list",
              "map",
              "file",
              "asset"
            ]
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "help": { "type": "string", "maxLength": 2048 },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["simple", "advanced"] }
          },
          "required": { "type": "boolean" },
          "default": true,
          "validation": { "type": "object" },
          "visibleWhen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "derivedFrom": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "catalogResolver": {
            "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
          },
          "allowCustomUnverified": { "type": "boolean" },
          "fieldMappings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination", "renderer", "rawOverride"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 512 },
          "destination": { "type": "string", "minLength": 1, "maxLength": 512 },
          "renderer": {
            "enum": [
              "text",
              "json",
              "toml",
              "yaml",
              "properties",
              "gradle",
              "binary"
            ]
          },
          "includeWhen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "executable": { "type": "boolean" },
          "rawOverride": { "enum": ["forbidden", "advanced-only", "allowed"] }
        }
      }
    },
    "assetSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mediaTypes", "maxBytes", "destinations"],
        "properties": {
          "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "mediaTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["image/png"] }
          },
          "maxBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "maxWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "maxHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "destinations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}
