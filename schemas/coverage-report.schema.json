{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:coverage-report:1",
  "title": "MCGen public coverage report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogId",
    "sourceSnapshots",
    "platforms"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:coverage-report:1" },
    "schemaVersion": {
      "$ref": "urn:mcgen:schema:common:1#/$defs/schemaVersion"
    },
    "rejectionAccountingVersion": { "const": 1 },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "catalogId": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
    "sourceSnapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest", "path", "entries"],
        "properties": {
          "id": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "digest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" },
          "path": {
            "type": "string",
            "pattern": "^(?:sources|catalog)/[a-zA-Z0-9._/-]+\\.json$"
          },
          "entries": { "type": "integer", "minimum": 0 },
          "rejected": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "discovered",
          "represented",
          "statuses",
          "entries",
          "blockers",
          "unexplainedGaps"
        ],
        "properties": {
          "platform": { "$ref": "urn:mcgen:schema:common:1#/$defs/identifier" },
          "discovered": { "type": "integer", "minimum": 0 },
          "represented": { "type": "integer", "minimum": 0 },
          "rejected": { "type": "integer", "minimum": 0 },
          "statuses": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "snapshotId",
                "entryIndex",
                "disposition",
                "shardId"
              ],
              "properties": {
                "snapshotId": {
                  "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
                },
                "entryIndex": { "type": "integer", "minimum": 0 },
                "disposition": { "enum": ["represented", "blocked"] },
                "shardId": {
                  "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
                },
                "blockerId": {
                  "$ref": "urn:mcgen:schema:common:1#/$defs/identifier"
                }
              }
            }
          },
          "blockers": {
            "type": "array",
            "items": { "$ref": "urn:mcgen:schema:catalog:1#/$defs/blocker" }
          },
          "unexplainedGaps": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      }
    }
  }
}
