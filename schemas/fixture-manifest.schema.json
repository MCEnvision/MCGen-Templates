{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcgen:schema:fixture-manifest:1",
  "title": "MCGen deterministic fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "tuple",
    "fixtures",
    "digest"
  ],
  "properties": {
    "$schema": { "const": "urn:mcgen:schema:fixture-manifest:1" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "fixture-manifest" },
    "tuple": {
      "$ref": "urn:mcgen:schema:phase5-common:1#/$defs/tupleIdentity"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:mcgen:schema:phase5-common:1#/$defs/fixture" }
    },
    "digest": { "$ref": "urn:mcgen:schema:common:1#/$defs/digest" }
  }
}
