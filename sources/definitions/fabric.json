    {
      "id": "fabric-meta-yarn",
      "role": "prerequisite",
      "url": "https://meta.fabricmc.net/v2/versions/yarn",
      "expectedContentTypes": ["application/json"]
    },
    {
      "id": "fabric-meta-intermediary",
      "role": "prerequisite",
      "url": "https://meta.fabricmc.net/v2/versions/intermediary",
      "expectedContentTypes": ["application/json"]
    },
    {
      "id": "fabric-meta-installer",
      "role": "prerequisite",
      "url": "https://meta.fabricmc.net/v2/versions/installer",
      "expectedContentTypes": ["application/json"]
    },
    {
      "id": "fabric-api-maven-metadata",
