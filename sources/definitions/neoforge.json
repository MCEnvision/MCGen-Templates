{
  "$schema": "urn:mcgen:schema:source-definition:1",
  "schemaVersion": 1,
  "id": "neoforge",
  "platform": "neoforge",
  "category": "mod",
  "adapter": "neoforge-maven",
  "sources": [
    {
      "id": "neoforge-maven-metadata",
      "role": "primary",
      "url": "https://maven.neoforged.net/releases/net/neoforged/neoforge/maven-metadata.xml",
      "expectedContentTypes": ["application/xml", "text/xml"]
    },
    {
      "id": "neoforge-moddevgradle-maven-metadata",
      "role": "prerequisite",
      "url": "https://maven.neoforged.net/releases/net/neoforged/moddev-gradle/maven-metadata.xml",
      "expectedContentTypes": ["application/xml", "text/xml"]
    },
    {
      "id": "neoforge-userdev-maven-metadata",
      "role": "prerequisite",
      "url": "https://maven.neoforged.net/releases/net/neoforged/gradle/userdev/maven-metadata.xml",
      "expectedContentTypes": ["application/xml", "text/xml"]
    },
    {
      "id": "neoforge-common-maven-metadata",
      "role": "prerequisite",
      "url": "https://maven.neoforged.net/releases/net/neoforged/gradle/common/maven-metadata.xml",
      "expectedContentTypes": ["application/xml", "text/xml"]
    },
    {
      "id": "neoforge-neoform-maven-metadata",
      "role": "prerequisite",
      "url": "https://maven.neoforged.net/releases/net/neoforged/gradle/neoform/maven-metadata.xml",
      "expectedContentTypes": ["application/xml", "text/xml"]
    },
    {
      "id": "neoforge-neoform-runtime-maven-metadata",
      "role": "prerequisite",
      "url": "https://maven.neoforged.net/releases/net/neoforged/neoform-runtime/maven-metadata.xml",
      "expectedContentTypes": ["application/xml", "text/xml"]
    },
    {
      "id": "neoforge-versioning-documentation",
      "role": "corroborating",
      "url": "https://docs.neoforged.net/docs/gettingstarted/versioning/",
      "expectedContentTypes": ["text/html"]
    }
  ],
  "removalPolicy": "additive-only",
  "requestPolicy": {
    "timeoutMs": 30000,
    "maxBytes": 2097152
  }
}
