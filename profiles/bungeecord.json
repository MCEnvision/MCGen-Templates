  "languages": ["java", "kotlin"],
  "features": [
    { "id": "commands", "support": "supported" },
    { "id": "event-listeners", "support": "supported" },
    { "id": "permissions", "support": "conditional" }
  ],
  "incompatibilities": [
    {
      "id": "api-history",
      "condition": "selected BungeeCord API line changes plugin metadata or Java requirements",
      "reason": "Proxy API compatibility is independent from Minecraft patch versions.",
      "resolution": "Split a profile at the documented API boundary."
    }
  ],
  "verification": {
    "commands": [
      ["./gradlew", "build"],
      ["./gradlew", "test"]
    ],
    "artifactPatterns": ["build/libs/*.jar"],
    "inspection": ["plugin.yml"]
  },
  "artifact": {
    "patterns": ["build/libs/*.jar"],
    "metadataPaths": ["plugin.yml"],
    "requiredEntries": ["plugin.yml"]
  },
  "fallback": {
    "policy": "blocked",
    "migration": "Resolve the exact BungeeCord API and Java tuple before generation."
  }
