    },
    {
      "id": "moddevgradle",
      "coordinate": "net.neoforged.moddev",
      "version": "selected-from-catalog",
      "range": "boundary-selected",
      "required": false,
      "catalogComponent": "moddevgradle"
    }
  ],
  "java": {
    "distribution": "temurin",
    "runtime": 21,
    "language": 21,
    "bytecode": 21
  },
  "build": {
    "system": "gradle",
    "wrapper": "8.8",
    "wrapperSha256": "a4b4158601f8636cdeeab09bd76afb640030bb5b144aafe261a5e8af027dc612",
    "dsl": "groovy",
    "plugins": [
      {
        "id": "net.neoforged.moddev",
        "version": "selected-from-catalog",
        "repositoryIds": ["neoforge"]
      }
    ],
    "properties": [{ "name": "minecraftVersion", "value": "catalog-selected" }],
    "jvmArguments": [],
    "sourceSets": [],
    "tasks": [],
    "publishing": false
  },
  "repositories": [
    { "id": "neoforge", "url": "https://maven.neoforged.net/releases/" },
    { "id": "central", "url": "https://repo.maven.apache.org/maven2/" }
  ],
  "mappings": {
    "strategy": "official",
    "components": [
      {
        "id": "official-mappings",
        "version": "selected-from-catalog",
        "coordinate": "net.minecraft:mappings"
      }
    ]
  },
  "metadata": {
    "format": "neoforge-neoforge-mods-toml",
    "files": ["src/main/resources/META-INF/neoforge.mods.toml"],
    "fieldMappings": [
      { "field": "project.id", "path": "mods[0].modId", "required": true },
      {
        "field": "project.name",
        "path": "mods[0].displayName",
        "required": true
      },
      {
        "field": "project.version",
        "path": "mods[0].version",
        "required": true
      }
    ]
  },
  "sourceLayout": {
    "sourceRoots": [{ "name": "main", "path": "src/main/java" }],
    "resourceRoots": [{ "name": "main", "path": "src/main/resources" }],
    "testRoots": [{ "name": "test", "path": "src/test/java" }],
    "generatedRoots": [{ "name": "data", "path": "src/generated/resources" }]
  },
  "languages": ["java", "kotlin"],
  "features": [
    { "id": "mixins", "support": "conditional" },
    { "id": "data-generation", "support": "conditional" },
    { "id": "access-transformers", "support": "conditional" }
  ],
  "incompatibilities": [
    {
      "id": "legacy-neoforge",
      "condition": "selected NeoForge key predates the ModDevGradle boundary",
      "reason": "Historical NeoForge build plugins and metadata require another profile.",
      "resolution": "Create a reviewed legacy boundary profile."
    }
  ],
  "verification": {
    "commands": [
      ["./gradlew", "build"],
      ["./gradlew", "test"]
    ],
    "artifactPatterns": ["build/libs/*.jar"],
    "inspection": ["META-INF/neoforge.mods.toml", "META-INF/MANIFEST.MF"]
  },
  "artifact": {
    "patterns": ["build/libs/*.jar"],
    "metadataPaths": ["META-INF/neoforge.mods.toml"],
    "requiredEntries": ["META-INF/MANIFEST.MF"]
  },
  "fallback": {
    "policy": "blocked",
    "migration": "Resolve the exact NeoGradle or ModDevGradle boundary before generation."
  }
}
