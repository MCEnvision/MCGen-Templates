        "components": [
          {
            "component": "neoforge",
            "coordinatePrefix": "net.neoforged:neoforge:",
            "mode": "all-components"
          }
        ],
        "evidence": [
          {
            "snapshotId": "neoforge.454d86de20b17a45eb60bd52",
            "path": "sources/snapshots/neoforge/2026-08-10-r2.json",
            "sha256": "53ef3e26fd1b0c0483e53bf0bcad9f3830bf29a72096a37916991c63f79382fd",
            "selectors": ["entries[].catalogKey", "entries[].coordinate"]
          }
        ]
      }
    ]
  },
  "components": [
