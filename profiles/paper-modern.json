{
  "$schema": "urn:mcgen:schema:toolchain-profile:1",
  "schemaVersion": 1,
  "id": "paper-modern",
  "revision": 1,
  "status": "blocked",
  "family": "paper",
  "category": "plugin",
  "platform": "paper",
  "blockers": [
    {
      "id": "paper-modern-evidence",
      "reason": "Paper plugin model and dependency graph fields need exact version boundary verification.",
      "evidence": ["sources/snapshots/paper/2026-08-10-r4.json"],
      "resolution": "Verify the modern metadata renderer and artifact inspection for each supported Paper boundary."
    }
  ],
  "catalog": {
    "snapshotId": "2026-08-10-r4",
    "indexPath": "catalog/2026-08-10-r4/platforms/paper/index.json",
    "indexSha256": "50b9d0c72eefbd535a1acad7fc139f4f0df8335c2e218d2c7e02ed1f6d50bd4c",
    "selectors": [
      {
        "platform": "paper",
        "keyKind": "minecraft",
        "keys": { "mode": "all-shards" },
        "components": [
          {
            "component": "paper",
            "coordinatePrefix": "io.papermc.paper:paper-api:",
            "mode": "all-components"
          }
        ],
        "evidence": [
          {
            "snapshotId": "paper.d0430553c2aaa457429a549e",
            "path": "sources/snapshots/paper/2026-08-10-r4.json",
            "sha256": "abb02e33b2eff11f2bc36ba5082777836d13e8b2b00e1c65e991265d079595e1",
            "selectors": ["entries[].catalogKey", "entries[].coordinate"]
          }
        ]
      }
    ]
  },
  "components": [
    {
      "id": "paper-api",
      "coordinate": "io.papermc.paper:paper-api",
      "version": "selected-from-catalog",
      "range": "modern-metadata",
      "required": true,
      "catalogComponent": "paper"
    }
  ],
  "java": {
    "distribution": "temurin",
    "runtime": 21,
    "language": 21,
    "bytecode": 21
  },
  "build": {
    "system": "gradle",
    "wrapper": "8.8",
    "wrapperSha256": "a4b4158601f8636cdeeab09bd76afb640030bb5b144aafe261a5e8af027dc612",
    "dsl": "kotlin",
    "plugins": [
      { "id": "java-library", "version": "8.8", "repositoryIds": ["central"] }
    ],
    "properties": [],
    "jvmArguments": [],
    "sourceSets": [],
    "tasks": [],
    "publishing": false
  },
  "repositories": [
    {
      "id": "papermc",
      "url": "https://repo.papermc.io/repository/maven-public/"
    },
    { "id": "central", "url": "https://repo.maven.apache.org/maven2/" }
  ],
  "mappings": { "strategy": "none", "components": [] },
  "metadata": {
    "format": "paper-plugin-yml",
    "files": ["src/main/resources/paper-plugin.yml"],
    "fieldMappings": [
      { "field": "project.name", "path": "name", "required": true },
      { "field": "project.mainClass", "path": "main", "required": true },
      { "field": "project.version", "path": "version", "required": true },
      {
        "field": "platform.bootstrapper",
        "path": "bootstrapper",
        "required": false
      },
      { "field": "platform.loader", "path": "loader", "required": false }
    ]
  },
  "sourceLayout": {
    "sourceRoots": [{ "name": "main", "path": "src/main/java" }],
    "resourceRoots": [{ "name": "main", "path": "src/main/resources" }],
    "testRoots": [{ "name": "test", "path": "src/test/java" }]
  },
  "languages": ["java", "kotlin"],
  "features": [
    { "id": "bootstrapper", "support": "conditional" },
    { "id": "loader", "support": "conditional" },
    { "id": "paper-dependencies", "support": "conditional" },
    { "id": "commands", "support": "supported" },
    { "id": "permissions", "support": "supported" }
  ],
  "incompatibilities": [
    {
      "id": "traditional-metadata",
      "condition": "selected Paper line only supports plugin.yml",
      "reason": "Modern bootstrap and loader keys are not accepted by traditional metadata.",
      "resolution": "Resolve paper-traditional instead."
    }
  ],
  "verification": {
    "commands": [
      ["./gradlew", "build"],
      ["./gradlew", "test"]
    ],
    "artifactPatterns": ["build/libs/*.jar"],
    "inspection": ["paper-plugin.yml", "paper-plugin.json"]
  },
  "artifact": {
    "patterns": ["build/libs/*.jar"],
    "metadataPaths": ["paper-plugin.yml", "paper-plugin.json"],
    "requiredEntries": ["paper-plugin.yml"]
  },
  "fallback": {
    "policy": "profile",
    "profile": "paper-traditional",
    "migration": "Use plugin.yml for an older Paper boundary."
  }
}
