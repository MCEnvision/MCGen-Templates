{
  "$schema": "urn:mcgen:schema:toolchain-profile:1",
  "schemaVersion": 1,
  "id": "velocity",
  "revision": 1,
  "status": "blocked",
  "family": "velocity",
  "category": "proxy",
  "platform": "velocity",
  "blockers": [
    {
      "id": "velocity-api-evidence",
      "reason": "Velocity API lines, Java, metadata, and optional Kotlin or annotation processing boundaries need compilation evidence.",
      "evidence": ["sources/snapshots/velocity/2026-08-10-r2.json"],
      "resolution": "Verify one API line per structural metadata boundary before enabling the profile."
    }
  ],
  "catalog": {
    "snapshotId": "2026-08-10-r4",
    "indexPath": "catalog/2026-08-10-r4/platforms/velocity/index.json",
    "indexSha256": "2280e2f4df8c0b6bfef52a8df10aa117cd01a3b0103bcb874f6a0e42cc475064",
    "selectors": [
      {
        "platform": "velocity",
        "keyKind": "api",
        "keys": { "mode": "all-shards" },
        "components": [
          {
            "component": "velocity-api",
            "coordinatePrefix": "com.velocitypowered:velocity-api:",
            "mode": "all-components"
          }
        ],
        "evidence": [
          {
            "snapshotId": "velocity.0dd1e06d8ce24cb894449c49",
            "path": "sources/snapshots/velocity/2026-08-10-r2.json",
            "sha256": "c479700cb3461ad419add8657eafbc7bfe317c4a5c122e15b4ab8b7ee04879f3",
            "selectors": ["entries[].catalogKey", "entries[].coordinate"]
          }
        ]
      }
    ]
  },
  "components": [
    {
      "id": "velocity-api",
      "coordinate": "com.velocitypowered:velocity-api",
      "version": "selected-from-catalog",
      "range": "api-key-compatible",
      "required": true,
      "catalogComponent": "velocity-api"
    }
  ],
  "java": {
    "distribution": "temurin",
    "runtime": 17,
    "language": 17,
    "bytecode": 17
  },
  "build": {
    "system": "gradle",
    "wrapper": "8.8",
    "wrapperSha256": "a4b4158601f8636cdeeab09bd76afb640030bb5b144aafe261a5e8af027dc612",
    "dsl": "kotlin",
    "plugins": [
      { "id": "java-library", "version": "8.8", "repositoryIds": ["central"] }
    ],
    "properties": [],
    "jvmArguments": [],
    "sourceSets": [],
    "tasks": [],
    "publishing": false
  },
  "repositories": [
    {
      "id": "velocity",
      "url": "https://repo.papermc.io/repository/maven-public/"
    },
    { "id": "central", "url": "https://repo.maven.apache.org/maven2/" }
  ],
  "mappings": { "strategy": "none", "components": [] },
  "metadata": {
    "format": "velocity-plugin-json",
    "files": ["src/main/resources/velocity-plugin.json"],
    "fieldMappings": [
      { "field": "project.id", "path": "id", "required": true },
      { "field": "project.name", "path": "name", "required": true },
      { "field": "project.mainClass", "path": "main", "required": true },
      { "field": "project.version", "path": "version", "required": true }
    ]
  },
  "sourceLayout": {
    "sourceRoots": [{ "name": "main", "path": "src/main/java" }],
    "resourceRoots": [{ "name": "main", "path": "src/main/resources" }],
    "testRoots": [{ "name": "test", "path": "src/test/java" }]
  },
  "languages": ["java", "kotlin"],
  "features": [
    { "id": "commands", "support": "supported" },
    { "id": "event-listeners", "support": "supported" },
    { "id": "annotation-processing", "support": "conditional" }
  ],
  "incompatibilities": [
    {
      "id": "api-history",
      "condition": "selected Velocity API line changes metadata or dependency semantics",
      "reason": "Proxy API compatibility is independent from Minecraft patch versions.",
      "resolution": "Split a profile at the documented API boundary."
    }
  ],
  "verification": {
    "commands": [
      ["./gradlew", "build"],
      ["./gradlew", "test"]
    ],
    "artifactPatterns": ["build/libs/*.jar"],
    "inspection": ["velocity-plugin.json"]
  },
  "artifact": {
    "patterns": ["build/libs/*.jar"],
    "metadataPaths": ["velocity-plugin.json"],
    "requiredEntries": ["velocity-plugin.json"]
  },
  "fallback": {
    "policy": "blocked",
    "migration": "Resolve the exact Velocity API and Java tuple before generation."
  }
}
